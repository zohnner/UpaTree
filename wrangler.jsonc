{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "upatree",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "upatree-db",
			"database_id": "1f2dfa0b-7e3a-4841-9601-8f68121f5d56"
		}
	]
}
